{
  "name": "factory-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "dev:ui-only": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:core": "node tests/engine.test.mjs && node tests/pi.test.mjs && node tests/sizes.test.mjs && node tests/order-import.test.mjs && node tests/intake.test.mjs && node tests/mis.test.mjs && node tests/dispatch-ledger.test.mjs && node tests/reference-import.test.mjs && node tests/reference-import.test.mjs && node tests/regressions.test.mjs",
    "test:ui-api": "vitest run",
    "test": "npm run test:core && npm run test:ui-api",
    "coverage:core": "c8 --all --include='shared/**/*.js' --exclude='shared/inputs.js' --exclude='shared/catalogue-seed.js' --check-coverage --lines=80 --branches=60 --functions=80 --report-dir=coverage/core --reporter=text --reporter=json-summary npm run test:core",
    "coverage:ui-api": "vitest run --coverage --coverage.reportsDirectory=coverage/ui-api",
    "test:coverage": "npm run coverage:core && npm run coverage:ui-api",
    "check": "npm run test:coverage && npm run build",
    "db:setup": "psql \"$DATABASE_URL\" -f db/schema.sql"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "c8": "^12.0.0",
    "exceljs": "^4.4.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
