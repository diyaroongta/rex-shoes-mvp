# Copy to .env.local for local dev. NEVER commit the real values.
# On Vercel these go in Project → Settings → Environment Variables.

# Postgres. Any provider: Neon, Supabase, Railway, RDS, or local.
DATABASE_URL=postgres://user:password@host:5432/factory_os?sslmode=require

# Only read by /api — never bundled into the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Signs the session cookie. REQUIRED: without it the portal refuses every
# request rather than accepting a cookie anyone could forge. At least 32
# characters; generate one with:  node scripts/create-user.mjs --secret
# Changing it signs everybody out immediately — which is how you revoke a
# session in a hurry.
AUTH_SECRET=generate-me-do-not-reuse-this-value

# Optional overrides
# AI_MODEL=claude-sonnet-4-6
# PGSSL=disable          # local Postgres without TLS
